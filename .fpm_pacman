-s dir
--name mill-box
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://github.com/swysgh/mill-box"
--maintainer "swysgh"
--config-files etc/mill-box/config.json
--after-install release/config/mill-box.postinst

release/config/config.json=/etc/mill-box/config.json

release/config/mill-box.service=/usr/lib/systemd/system/mill-box.service
release/config/mill-box@.service=/usr/lib/systemd/system/mill-box@.service
release/config/mill-box.sysusers=/usr/lib/sysusers.d/mill-box.conf
release/config/mill-box.rules=usr/share/polkit-1/rules.d/mill-box.rules
release/config/mill-box-split-dns.xml=/usr/share/dbus-1/system.d/mill-box-split-dns.conf

release/completions/mill-box.bash=/usr/share/bash-completion/completions/mill-box.bash
release/completions/mill-box.fish=/usr/share/fish/vendor_completions.d/mill-box.fish
release/completions/mill-box.zsh=/usr/share/zsh/site-functions/_mill-box

LICENSE=/usr/share/licenses/mill-box/LICENSE
