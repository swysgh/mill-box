[Unit]
Description=mill-box service
Documentation=https://github.com/swysgh/mill-box
Wants=network-online.target
After=network.target nss-lookup.target network-online.target

[Service]
User=mill-box
Group=mill-box
StateDirectory=mill-box
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ExecStartPre=/usr/bin/mill-box -D /var/lib/mill-box -C /etc/mill-box check
ExecStart=/usr/bin/mill-box -D /var/lib/mill-box -C /etc/mill-box run
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
LimitNOFILE=infinity
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/mill-box

[Install]
WantedBy=multi-user.target
