[Unit]
Description=mill-box service
Documentation=https://github.com/swysgh/mill-box
After=network.target nss-lookup.target network-online.target

[Service]
StateDirectory=mill-box
ExecStartPre=sh -c 'ip rule show | grep -q "fwmark 0x1 lookup 100" || ip rule add fwmark 1 table 100'
ExecStartPre=sh -c 'ip -6 rule show | grep -q "fwmark 0x1 lookup 100" || ip -6 rule add fwmark 1 table 100'
ExecStartPre=-ip route add local default dev lo table 100
ExecStartPre=-ip -6 route add local default dev lo table 100
ExecStart=/usr/bin/mill-box -D /var/lib/mill-box -C /etc/mill-box run
ExecStop=-ip route del local default dev lo table 100
ExecStop=-ip -6 route del local default dev lo table 100
ExecStop=-ip rule del fwmark 1 table 100
ExecStop=-ip -6 rule del fwmark 1 table 100
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
